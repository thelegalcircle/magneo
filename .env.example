# Add these in Vercel's environment settings, never in client-side VITE_* variables.
# Leave disabled until all services and real delivery have been verified.
INTAKE_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
HUBSPOT_PRIVATE_APP_TOKEN=
RESEND_API_KEY=
INTAKE_EMAIL_FROM=
INTAKE_EMAIL_TO=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: exact HTTPS origin of a private Vercel preview used for testing.
INTAKE_PREVIEW_ORIGIN=
